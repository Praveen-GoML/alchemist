# Copy to .env and fill in. Vite only exposes variables that start with VITE_.

# PreQ backend (FastAPI). Local default is http://127.0.0.1:8002, set this for deployments.
VITE_API_URL=http://127.0.0.1:8002

# Optional: public origin used to build shareable links (defaults to VITE_API_URL without /api)
VITE_BASE_URL=

# Alchemist auth backend origin, without a trailing /api (local default http://localhost:8001)
VITE_AUTH_API_URL=http://localhost:8001

# Firebase web app (Docs & Drive storage). Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
