# Copy to .env and fill in.

# Database. Leave empty for local SQLite (preq_local.db); use Postgres in production.
DATABASE_URL=

# AI provider key (Google Gemini). Users can also supply their own key from the UI.
GEMINI_API_KEY=
# Legacy fallback: a Groq key (gsk_...) is auto-detected if used instead.
GROQ_API_KEY=

# Encryption key for client-shared credentials (REQUIRED in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Locally, if empty, a .credential_key file is created automatically.
CREDENTIAL_ENCRYPTION_KEY=

# Enables GET /api/items/{id}/credential for authorised staff (sent as the X-Admin-Token header).
# Leave empty to keep the reveal endpoint disabled.
PREQ_ADMIN_TOKEN=

# Optional Slack incoming webhook for escalation / credential-share notifications
SLACK_WEBHOOK_URL=
